dist/
debian/
release-assets/

# Meson/Ninja build files
.ninja_deps
.ninja_log
compile_commands.json
meson-private/
meson-info/
meson-logs/
*.o

# Vala compiler generated files
*.c
*.h

# Hand-written platform shims under src/ are sources, not Vala output
!src/*_shim.c
!src/*_shim.h

# GTK resource files
*-resources.c
*-resources.h

# Generated UI from blueprint (data/window.ui is stale and should not be committed)
data/window.ui

# Debug symbols
*.debug

