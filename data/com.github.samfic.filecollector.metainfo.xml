<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.github.samfic.filecollector</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>FileCollector</name>
  <summary>文件收集与编排工具</summary>
  <description>
    <p>FileCollector 是一款桌面工具，能够帮助用户快速收集和编排文件内容。</p>
    <p>主要功能：</p>
    <ul>
      <li>通过目录树浏览并勾选需要收集的文件</li>
      <li>灵活编排文件输出顺序</li>
      <li>在文件之间插入自定义文字或常用语</li>
      <li>一键合并生成文本文件</li>
      <li>支持项目文件的保存与加载</li>
    </ul>
  </description>
  <launchable type="desktop-id">com.github.samfic.filecollector.desktop</launchable>
  <url type="homepage">https://github.com/Sam-Fic/filecollector-gnome</url>
  <developer id="com.github.samfic">
    <name>Sam-Fic</name>
  </developer>
  <content_rating type="oars-1.1" />
  <releases>
    <release version="3.0.1" date="2026-05-28">
      <description>
        <p>新特性与修复：</p>
        <ul>
          <li>编辑常用语功能：允许用户修改已保存的短语内容</li>
          <li>优化队列按钮状态更新逻辑，保持界面响应一致性</li>
          <li>更新语言设置逻辑，优化多语言切换流程</li>
          <li>更新版本发布流程文档，完善版本号说明和构建细节</li>
        </ul>
      </description>
    </release>
    <release version="3.0.0" date="2026-05-28">
      <description>
        <p>新特性与修复：</p>
        <ul>
          <li>国际化支持：添加 gettext 支持，支持中英文切换（跟随系统、中文、英文）</li>
          <li>UI 改进：按钮状态优化（仅在选择状态下可编辑）、Paned 布局限制、分隔器样式调整</li>
          <li>错误修复：修复文件替换时的覆盖逻辑问题</li>
          <li>代码优化：Toast 提示替代冗余弹窗，统一消息反馈</li>
        </ul>
      </description>
    </release>
    <release version="2.0.4" date="2026-05-27">
      <description>
        <p>新特性与修复：</p>
        <ul>
          <li>目录树排序：文件夹与文件分开排序，文件夹在前且按字母排序</li>
          <li>列渲染优化：复选框列与名称列合并为单列</li>
          <li>自动生成后缀：输出文件名自动补全 .txt 后缀</li>
          <li>剪贴板格式：合并文本复制到剪贴板改为纯文本格式</li>
          <li>Toast 提示：使用 Adw.Toast 替代旧式对话框显示操作结果</li>
        </ul>
      </description>
    </release>
    <release version="2.0.3" date="2026-05-27">
      <description>
        <p>新特性与修复：</p>
        <ul>
          <li>一键复制到剪贴板：新增按钮，生成的文件名列表可一键粘贴到任何地方</li>
          <li>常用语选择器重构：提取为独立方法，大幅提升代码可读性和可维护性</li>
          <li>对话框层级修复：确保新建常用语对话框正确显示在最顶层</li>
        </ul>
      </description>
    </release>
    <release version="2.0.2" date="2026-05-26">
      <description>
        <p>新特性与修复：</p>
        <ul>
          <li>标题显示修复：修复选择工作目录后标题栏仍显示"未设置工作目录"的问题</li>
          <li>自动展开优化：打开工作目录后左侧文件树最上层文件夹默认自动展开</li>
          <li>卡片边距调整：主界面三栏卡片顶部直接贴边（去除与标题栏之间的多余间距）</li>
        </ul>
      </description>
    </release>
    <release version="2.0.1" date="2026-05-26"/>
  </releases>
</component>