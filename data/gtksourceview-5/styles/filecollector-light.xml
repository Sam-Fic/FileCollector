<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="filecollector-light" _name="FileCollector Light" version="1.0">
  <_description>Transparent background scheme for light mode</_description>
  <metadata>
    <property name="variant">light</property>
    <property name="dark-variant">filecollector-dark</property>
  </metadata>

  <color name="bg"          value="#00000000"/>
  <color name="fg"          value="#1e1e1e"/>
  <color name="fg_dim"      value="#77767b"/>
  <color name="blue"        value="#1a5fb4"/>
  <color name="green"       value="#26a269"/>
  <color name="orange"      value="#c64600"/>
  <color name="purple"      value="#813d9c"/>
  <color name="red"         value="#c01c28"/>
  <color name="yellow"      value="#a5a50a"/>
  <color name="cyan"        value="#0e7c86"/>

  <style name="text"                        background="bg" foreground="fg"/>
  <style name="selection"                   background="#3584e4" foreground="#ffffff"/>
  <style name="current-line"                background="bg"/>
  <style name="line-numbers"                background="bg" foreground="fg_dim"/>
  <style name="current-line-number"         background="bg" foreground="fg_dim"/>
  <style name="background-pattern"          background="bg"/>
  <style name="right-margin"                background="bg"/>
  <style name="draw-spaces"                 foreground="bg"/>

  <style name="def:comment"                 foreground="fg_dim" italic="true"/>
  <style name="def:keyword"                 foreground="blue"/>
  <style name="def:statement"               foreground="blue"/>
  <style name="def:type"                    foreground="cyan"/>
  <style name="def:function"                foreground="green"/>
  <style name="def:identifier"              foreground="fg"/>
  <style name="def:string"                  foreground="green"/>
  <style name="def:special-char"            foreground="purple"/>
  <style name="def:number"                  foreground="orange"/>
  <style name="def:float"                   foreground="orange"/>
  <style name="def:boolean"                 foreground="orange"/>
  <style name="def:constant"                foreground="orange"/>
  <style name="def:preprocessor"            foreground="red"/>
  <style name="def:error"                   foreground="red" underline="error"/>
  <style name="def:warning"                 foreground="yellow" underline="error"/>
  <style name="def:builtin"                 foreground="cyan"/>
</style-scheme>
