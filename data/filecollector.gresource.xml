<?xml version="1.0" encoding="UTF-8"?>
<gresources>
  <gresource prefix="/io/github/sam_fic/filecollector">
    <file preprocess="xml-stripblanks">window.ui</file>
    <file>style.css</file>
    <file alias="icons/io.github.sam_fic.filecollector.svg">icons/hicolor/scalable/apps/io.github.sam_fic.filecollector.svg</file>
    <file alias="icons/scalable/apps/io.github.sam_fic.filecollector.svg">icons/hicolor/scalable/apps/io.github.sam_fic.filecollector.svg</file>
    <!-- hicolor/ 子树是图标兜底的唯一数据源: main.vala 启动时递归枚举该子树,
         逐个检查 IconTheme 能否按名解析; 有缺失 (未安装到系统, 如 builddir 直接
         运行) 时整体解包到 ~/.cache/<app_id>/icons/ 并加入搜索路径, 同时按
         解包结果生成 index.theme。新增托管图标: 放进 data/icons/hicolor/ 对应
         子目录并在下方登记一行, main.vala 无需改动。xsi-* (XApp Symbolic
         Icons) 不在此图标库中。 -->
    <file alias="icons/hicolor/scalable/actions/xsi-git-symbolic.svg" preprocess="xml-stripblanks">icons/hicolor/scalable/actions/xsi-git-symbolic.svg</file>
    <file alias="icons/hicolor/scalable/actions/xsi-text-case-symbolic.svg" preprocess="xml-stripblanks">icons/hicolor/scalable/actions/xsi-text-case-symbolic.svg</file>
    <file alias="icons/hicolor/scalable/apps/io.github.sam_fic.filecollector.svg" preprocess="xml-stripblanks">icons/hicolor/scalable/apps/io.github.sam_fic.filecollector.svg</file>
    <file alias="icons/hicolor/scalable/apps/io.github.sam_fic.filecollector-symbolic.svg" preprocess="xml-stripblanks">icons/hicolor/scalable/apps/io.github.sam_fic.filecollector-symbolic.svg</file>
  </gresource>
</gresources>