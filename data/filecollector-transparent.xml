<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="filecollector-transparent" _name="FileCollector Transparent" version="1.0">
  <_description>Transparent background scheme for FileCollector preview</_description>
  <metadata>
    <property name="variant">dark</property>
  </metadata>

  <style name="text"                        background="transparent" foreground="alpha(currentColor, 0.87)"/>
  <style name="selection"                   background="#3584e4" foreground="#ffffff"/>
  <style name="current-line"                background="transparent"/>
  <style name="line-numbers"                background="transparent" foreground="alpha(currentColor, 0.5)"/>
  <style name="current-line-number"         background="transparent" foreground="alpha(currentColor, 0.5)"/>
  <style name="background-pattern"          background="transparent"/>
  <style name="right-margin"                background="transparent"/>
  <style name="draw-spaces"                 foreground="transparent"/>

  <style name="def:comment"                 foreground="alpha(currentColor, 0.5)" italic="true"/>
  <style name="def:keyword"                 foreground="#3584e4"/>
  <style name="def:statement"               foreground="#3584e4"/>
  <style name="def:type"                    foreground="#e66100"/>
  <style name="def:function"                foreground="#3584e4" bold="true"/>
  <style name="def:string"                  foreground="#26a269"/>
  <style name="def:special-char"            foreground="#c061cb"/>
  <style name="def:number"                  foreground="#e66100"/>
  <style name="def:float"                   foreground="#e66100"/>
  <style name="def:boolean"                 foreground="#e66100"/>
  <style name="def:constant"                foreground="#e66100"/>
  <style name="def:preprocessor"            foreground="#a51d2d"/>
  <style name="def:error"                   foreground="#c01c28" underline="error"/>
  <style name="def:warning"                 foreground="#e5a50a" underline="error"/>

  <style name="diff:added-line"             foreground="#26a269"/>
  <style name="diff:removed-line"           foreground="#c01c28"/>
  <style name="diff:changed-line"           foreground="#e5a50a"/>
  <style name="diff:diff-file"              foreground="#3584e4" bold="true"/>
  <style name="diff:location"               foreground="#a51d2d"/>
</style-scheme>
