using Gtk 4.0;
using Adw 1;
using GtkSource 5;

template $FileCollectorWindow : Adw.ApplicationWindow {
  default-width: 1200;
  default-height: 750;
  title: _("FileCollector - 文件收集与编排工具");
  content: Adw.ToastOverlay toast_overlay {
    Adw.ToolbarView {
      [top]
      Adw.HeaderBar {
        Button btn_ai_toggle {
          icon-name: "chat-message-new-symbolic";
          tooltip-text: _("显示 / 隐藏 AI 助手 (Ctrl+J)");
        }

        Button open_folder_btn {
          icon-name: "folder-open-symbolic";
          tooltip-text: _("打开工作目录");
        }

        Button btn_toggle_git {
          icon-name: "xsi-git-symbolic";
          tooltip-text: _("切换到 Git 提交历史");
          sensitive: false;
        }

        Button btn_global_search {
          icon-name: "edit-find-symbolic";
          tooltip-text: _("全局内容搜索 (Ctrl+Shift+F)");
          sensitive: false;
        }

        Button btn_undo {
          icon-name: "edit-undo-symbolic";
          tooltip-text: _("撤销");
          sensitive: false;
        }

        Button btn_redo {
          icon-name: "edit-redo-symbolic";
          tooltip-text: _("重做");
          sensitive: false;
        }

        title-widget: Adw.WindowTitle {
          title: _("FileCollector");
          subtitle: _("未设置工作目录");
        };

        [end]
        Gtk.MenuButton menu_btn {
          icon-name: "open-menu-symbolic";
          menu-model: primary_menu;
        }
      }

      content: Paned ai_paned {
       orientation: horizontal;
       margin-top: 0;
       margin-bottom: 12;
       margin-start: 12;
       margin-end: 12;
       position: 320;
       shrink-start-child: false;
       shrink-end-child: false;
       css-classes: ["paned-no-handle"];

       // AI 边栏 (最左, 可折叠)
       Frame ai_sidebar {
          visible: false;
          hexpand: false;
          vexpand: true;
          width-request: 280;
          margin-top: 0;
          margin-bottom: 6;
          margin-start: 6;
          margin-end: 6;
          css-classes: ["ai-panel", "panel-frame"];
       }

      Paned outer_paned {
       orientation: horizontal;
       margin-top: 0;
       margin-bottom: 0;
       margin-start: 0;
       margin-end: 0;
       position: 300;
       shrink-start-child: false;
       shrink-end-child: false;
       css-classes: ["paned-no-handle"];

        // 左栏 - 目录树 / Git 历史
        Frame {
           hexpand: true;
           vexpand: true;
           width-request: 200;
           margin-top: 0;
           margin-bottom: 6;
           margin-start: 6;
           margin-end: 6;
           css-classes: ["left-panel", "panel-frame"];
         Box {
           styles ["card"]
           orientation: vertical;
           spacing: 0;
           hexpand: true;
           vexpand: true;

            // 标题
            Label lbl_left_title {
              label: _("资源管理器");
              halign: center;
              css-classes: ["panel-title"];
              margin-top: 0;
              margin-bottom: 0;
              margin-start: 12;
              margin-end: 12;
            }

           // 内容 Stack: 文件树 / Git 历史
           Stack left_stack {
             transition-type: crossfade;
             vexpand: true;

             // 页面 1: 文件树
              Box tree_page {
                orientation: vertical;

               Gtk.SearchEntry search_entry {
                 placeholder-text: _("搜索…");
                 margin-bottom: 6;
                 margin-start: 12;
                 margin-end: 12;
               }

               ScrolledWindow dir_scrolled {
                 hexpand: true;
                 vexpand: true;
                 margin-start: 12;
                 margin-end: 12;
                 margin-top: 0;
                 margin-bottom: 6;
               }
             }

             // 页面 2: Git 提交历史
              Box git_page {
                orientation: vertical;

               Gtk.SearchEntry git_search_entry {
                 placeholder-text: _("搜索提交信息…");
                 margin-bottom: 6;
                 margin-start: 12;
                 margin-end: 12;
               }

               ScrolledWindow git_scrolled {
                 hexpand: true;
                 vexpand: true;
                 margin-start: 12;
                 margin-end: 12;
                 margin-top: 0;
                 margin-bottom: 6;
                 ListView git_list_view {}
               }
              }
            }
          }
        }

      Paned inner_paned {
        orientation: horizontal;
        position: 500;
        shrink-start-child: false;
        shrink-end-child: false;
        margin-start: 6;
        css-classes: ["paned-no-handle"];

        // 中栏 - 输出编排
        Frame {
           hexpand: true;
           vexpand: true;
           width-request: 400;
           margin-top: 0;
           margin-bottom: 6;
           margin-start: 0;
           margin-end: 6;
           css-classes: ["middle-panel", "panel-frame"];
          Box {
            styles ["card"]
             orientation: vertical;
             spacing: 0;
             hexpand: true;
             vexpand: true;

             // 标题区
             Label {
               label: _("输出编排列表");
               halign: center;
               css-classes: ["panel-title"];
             }

             // 队列列表区
             ScrolledWindow {
               vexpand: true;
               margin-start: 12;
               margin-end: 12;
               margin-top: 0;
               margin-bottom: 6;
              ListView queue_list {
              }
            }

            // 操作按钮 Stack: 常规 / Git 专属
            Stack action_stack {
              transition-type: crossfade;
              margin-top: 6;
              margin-start: 12;
              margin-end: 12;

              // 页面 1: 常规编排按钮
              Box normal_actions {
                css-classes: ["normal-actions"];
                orientation: horizontal;
                halign: center;
                spacing: 6;
                Button btn_add_ext {
                  icon-name: "document-open-symbolic";
                  tooltip-text: _("添加外部文件");
                }
                Button btn_add_text_above {
                  sensitive: false;
                  icon-name: "go-top-symbolic";
                  tooltip-text: _("上方插入文本");
                }
                Button btn_add_text_below {
                  sensitive: false;
                  icon-name: "go-bottom-symbolic";
                  tooltip-text: _("下方插入文本");
                }
                Button btn_move_up {
                  sensitive: false;
                  icon-name: "go-up-symbolic";
                  tooltip-text: _("上移");
                }
                Button btn_move_down {
                  sensitive: false;
                  icon-name: "go-down-symbolic";
                  tooltip-text: _("下移");
                }
                Button btn_ai_toc {
                  sensitive: false;
                  icon-name: "xsi-view-list-ordered-symbolic";
                  tooltip-text: _("AI 生成阅读指南");
                }
                Button btn_delete {
                  sensitive: false;
                  css-classes: ["destructive-action"];
                  icon-name: "edit-clear-symbolic";
                  tooltip-text: _("删除");
                }
                Button btn_clear {
                  sensitive: false;
                  css-classes: ["destructive-action"];
                  icon-name: "user-trash-symbolic";
                  tooltip-text: _("清空");
                }
              }

              // 页面 2: Git 专属按钮
              Box git_actions {
                css-classes: ["normal-actions"];
                orientation: horizontal;
                halign: center;
                spacing: 6;

                Button btn_git_add_all_changed {
                  icon-name: "document-open-symbolic";
                  tooltip-text: _("一键添加所有改动文件");
                }

                Button btn_git_export_working_diff {
                  icon-name: "edit-copy-symbolic";
                  tooltip-text: _("导出工作区 Diff");
                }

                Button btn_git_export_commit_diff {
                  sensitive: false;
                  icon-name: "document-save-symbolic";
                  tooltip-text: _("导出选中 Commit Diff");
                }

                Button btn_git_delete {
                  sensitive: false;
                  css-classes: ["destructive-action"];
                  icon-name: "edit-clear-symbolic";
                  tooltip-text: _("删除");
                }

                Button btn_git_clear {
                  sensitive: false;
                  css-classes: ["destructive-action"];
                  icon-name: "user-trash-symbolic";
                  tooltip-text: _("清空");
                }
              }
            }

            // 选项区
            Box {
              orientation: vertical;
              spacing: 4;
              halign: center;
              margin-top: 6;
              margin-start: 12;
              margin-end: 12;

              Box {
                orientation: horizontal;
                spacing: 12;
                halign: center;

                CheckButton radio_relative_path {
                  label: _("使用相对路径");
                  sensitive: false;
                }

                CheckButton radio_absolute_path {
                  label: _("使用绝对路径");
                  group: radio_relative_path;
                  sensitive: false;
                }
              }

              CheckButton check_write_header {
                label: _("在文件头部标注工作目录信息");
                halign: center;
                sensitive: false;
              }
            }

            // 生成按钮
            Box {
              orientation: vertical;
              halign: center;
              spacing: 6;
              margin-top: 6;
              margin-start: 12;
              margin-end: 12;
              margin-bottom: 12;
              Box {
                orientation: horizontal;
                halign: center;
                spacing: 6;
                Button btn_generate {
                  halign: center;
                  sensitive: false;
                  css-classes: ["suggested-action"];
                  tooltip-text: _("预估上下文: 0 / 128000 Tokens");
                  Box {
                    spacing: 6;
                    halign: center;
                    Image { icon-name: "document-save-symbolic"; }
                    Label { label: _("生成合并文本"); }
                    DrawingArea token_ring {
                      width-request: 18;
                      height-request: 18;
                      valign: center;
                      margin-start: 4;
                    }
                  }
                }
                Gtk.MenuButton btn_more_menu {
                  valign: center;
                  icon-name: "view-more-symbolic";
                  tooltip-text: _("更多操作");
                  menu-model: generate_menu;
                }
              }
            }
          }
        }

        // 右栏 - 预览
        Frame {
           hexpand: true;
           vexpand: true;
           width-request: 200;
           margin-top: 0;
           margin-bottom: 6;
           margin-start: 6;
           margin-end: 6;
           css-classes: ["right-panel", "panel-frame"];
            Box {
              styles ["card"]
              orientation: vertical;
              spacing: 0;
              hexpand: true;
              vexpand: true;

              Label {
               label: _("预览");
               halign: center;
               css-classes: ["panel-title"];
             }

             Gtk.Overlay {
               hexpand: true;
               vexpand: true;
               margin-start: 12;
               margin-end: 12;

               child: ScrolledWindow {
                 hexpand: true;
                 vexpand: true;
                  Box preview_container {
                    orientation: vertical;
                    GtkSource.View preview_view {
                      editable: false;
                      left-margin: 12;
                      right-margin: 12;
                      top-margin: 9;
                      bottom-margin: 12;
                    }
                 }
               };

               [overlay]
               Button btn_retry_preprocess {
                 visible: false;
                 halign: end;
                 valign: start;
                 margin-top: 6;
                 margin-end: 6;
                 icon-name: "view-refresh-symbolic";
                 tooltip-text: _("重新进行 AI 转换");
               }
             }
           }
         }
      }
    }
  };
  }
  };
}

menu primary_menu {
  section {
    item (_("打开项目..."), "app.open_project")
    item (_("保存项目"), "app.save_project")
    item (_("项目另存为..."), "app.save_as_project")
  }
  section {
    item (_("常用语管理..."), "app.manage_phrases")
    item (_("场景模板管理..."), "app.manage_templates")
    item (_("AI 设置..."), "app.ai_settings")
    item (_("清除工作区缓存"), "app.clear_cache")
    item (_("上下文窗口设置..."), "app.context_window_settings")
    item (_("语言设置..."), "app.settings")
  }
  section {
    item (_("键盘快捷键..."), "app.shortcuts")
    item (_("关于 FileCollector"), "app.about")
  }
}

menu generate_menu {
  section {
    item (_("生成合并文本到剪贴板"), "win.generate_to_clipboard")
    item (_("导出为 ZIP"), "win.export_zip")
  }
}
