using Gtk 4.0;
using Adw 1;

template $FileCollectorWindow : Adw.ApplicationWindow {
  default-width: 1200;
  default-height: 750;
title: _("FileCollector - 文件收集与编排工具");
     content: Adw.ToastOverlay toast_overlay {
      Adw.ToolbarView {
      [top]
      Adw.HeaderBar {
        Button open_folder_btn {
          icon-name: "folder-open-symbolic";
          tooltip-text: _("打开工作目录");
        }

        Button btn_undo {
          icon-name: "edit-undo-symbolic";
          tooltip-text: _("撤销");
          sensitive: false;
        }

        Button btn_redo {
          icon-name: "edit-redo-symbolic";
          tooltip-text: _("重做");
          sensitive: false;
        }

        title-widget: Adw.WindowTitle {
          title: _("FileCollector");
          subtitle: _("未设置工作目录");
        };

        [end]
        Gtk.MenuButton menu_btn {
          icon-name: "open-menu-symbolic";
          menu-model: primary_menu;
        }
      }

      content: Paned outer_paned {
       orientation: horizontal;
       margin-top: 0;
       margin-bottom: 12;
       margin-start: 12;
       margin-end: 12;
       position: 300;
       shrink-start-child: false;
       shrink-end-child: false;
       css-classes: ["paned-no-handle"];

       // 左栏 - 目录树
       Frame {
          hexpand: true;
          vexpand: true;
          width-request: 200;
          margin-top: 0;
          margin-bottom: 6;
          margin-start: 6;
          margin-end: 6;
          css-classes: ["left-panel", "panel-frame"];
         Box {
           styles ["card"]
           orientation: vertical;
           spacing: 0;
           hexpand: true;
           vexpand: true;

           Label {
              label: _("资源管理器");
              halign: center;
              css-classes: ["panel-title"];
            }

             Gtk.SearchEntry search_entry {
               placeholder-text: _("搜索…");
               margin-bottom: 6;
               margin-start: 12;
               margin-end: 12;
             }

            ScrolledWindow {
             hexpand: true;
             vexpand: true;
             margin-start: 12;
             margin-end: 12;
             margin-top: 0;
             margin-bottom: 6;
             TreeView dir_tree {
               headers-visible: false;
               visible: false;
             }
           }
         }
       }

      Paned inner_paned {
        orientation: horizontal;
        position: 500;
        shrink-start-child: false;
        shrink-end-child: false;
        margin-start: 6;
        css-classes: ["paned-no-handle"];

        // 中栏 - 输出编排
        Frame {
           hexpand: true;
           vexpand: true;
           width-request: 400;
           margin-top: 0;
           margin-bottom: 6;
           margin-start: 0;
           margin-end: 6;
           css-classes: ["middle-panel", "panel-frame"];
          Box {
            styles ["card"]
             orientation: vertical;
             spacing: 0;
             hexpand: true;
             vexpand: true;

             // 标题区
             Label {
               label: _("输出编排列表");
               halign: center;
               css-classes: ["panel-title"];
             }

             // 队列列表区
             ScrolledWindow {
               vexpand: true;
               margin-start: 12;
               margin-end: 12;
               margin-top: 0;
               margin-bottom: 6;
              ListView queue_list {
              }
            }

            // 按钮区 - 添加文件/文字
            Box {
              orientation: horizontal;
              halign: center;
              spacing: 6;
              margin-top: 6;
              margin-start: 12;
              margin-end: 12;
              Button btn_add_ext {
                Box {
                  spacing: 4;
                  Image { icon-name: "document-open-symbolic"; }
                  Label { label: _("添加外部文件"); }
                }
              }
              Button btn_add_text_above {
                Box {
                  spacing: 4;
                  Image { icon-name: "go-up-symbolic"; }
                  Label { label: _("上方插入文本"); }
                }
              }
              Button btn_add_text_below {
                Box {
                  spacing: 4;
                  Image { icon-name: "go-down-symbolic"; }
                  Label { label: _("下方插入文本"); }
                }
              }
            }

            // 按钮区 - 移动/删除
            Box {
              orientation: horizontal;
              halign: center;
              spacing: 6;
              margin-top: 6;
              margin-start: 12;
              margin-end: 12;
              Button btn_move_up {
                Box {
                  spacing: 4;
                  Image { icon-name: "go-up-symbolic"; }
                  Label { label: _("上移"); }
                }
              }
              Button btn_move_down {
                Box {
                  spacing: 4;
                  Image { icon-name: "go-down-symbolic"; }
                  Label { label: _("下移"); }
                }
              }
              Button btn_delete {
                css-classes: ["destructive-action"];
                Box {
                  spacing: 4;
                  Image { icon-name: "user-trash-symbolic"; }
                  Label { label: _("删除"); }
                }
              }
              Button btn_clear {
                css-classes: ["destructive-action"];
                Box {
                  spacing: 4;
                  Image { icon-name: "edit-clear-symbolic"; }
                  Label { label: _("清空"); }
                }
              }
            }

            // 选项区
            Box {
              orientation: vertical;
              spacing: 4;
              margin-top: 6;
              margin-start: 12;
              margin-end: 12;
              CheckButton check_absolute_path { label: _("使用绝对路径"); }
              CheckButton check_write_header { label: _("在文件头部标注工作目录信息"); }
            }

            // 生成按钮
            Box {
              orientation: horizontal;
              halign: center;
              spacing: 6;
              margin-top: 6;
              margin-start: 12;
              margin-end: 12;
              margin-bottom: 12;
              Button btn_generate {
                css-classes: ["suggested-action"];
                hexpand: true;
                Box {
                  spacing: 4;
                  Image { icon-name: "document-save-symbolic"; }
                  Label { label: _("生成合并文本"); }
                }
              }
              Button btn_generate_clipboard {
                css-classes: ["suggested-action"];
                hexpand: true;
                Box {
                  spacing: 4;
                  Image { icon-name: "edit-copy-symbolic"; }
                  Label { label: _("生成合并文本到剪贴板"); }
                }
              }
            }
          }
        }

        // 右栏 - 预览
        Frame {
           hexpand: true;
           vexpand: true;
           width-request: 200;
           margin-top: 0;
           margin-bottom: 6;
           margin-start: 6;
           margin-end: 6;
           css-classes: ["right-panel", "panel-frame"];
            Box {
              styles ["card"]
              orientation: vertical;
              spacing: 0;
              hexpand: true;
              vexpand: true;

              Label {
               label: _("预览");
               halign: center;
               css-classes: ["panel-title"];
             }

              ScrolledWindow {
               hexpand: true;
               vexpand: true;
               margin-start: 12;
               margin-end: 12;
               TextView preview_view {
                 editable: false;
                 wrap-mode: word_char;
                 left-margin: 12;
                 right-margin: 12;
                 top-margin: 9;
                 bottom-margin: 12;
               }
             }
           }
         }
      }
    };
  }
  };
}

menu primary_menu {
  section {
    item (_("打开项目..."), "app.open_project")
    item (_("保存项目"), "app.save_project")
  }
  section {
    item (_("常用语管理"), "app.manage_phrases")
    item (_("语言设置"), "app.settings")
  }
  section {
    item (_("键盘快捷键"), "app.shortcuts")
    item (_("关于 FileCollector"), "app.about")
  }
}