using Gtk 4.0;
using Adw 1;
using GtkSource 5;

template $FileCollectorWindow : Adw.ApplicationWindow {
  default-width: 1200;
  default-height: 750;
  // 设最小高度, 消除 libadwaita "does not have a minimum height" 警告,
  // 并避免窗口被拖拽到过矮导致布局异常.
  height-request: 480;
  title: _("FileCollector - File Collection & Orchestration Tool");
  content: Adw.ToastOverlay toast_overlay {
    Adw.ToolbarView main_view {
      [top]
      Adw.HeaderBar {
        Button btn_toggle_snapshot {
          icon-name: "sidebar-show-symbolic";
          tooltip-text: _("Show / Hide Workspaces Sidebar");
        }

        Button btn_ai_toggle {
          icon-name: "chat-message-new-symbolic";
          tooltip-text: _("Show / Hide AI Assistant (Ctrl+J)");
        }

        Button open_folder_btn {
          icon-name: "folder-open-symbolic";
          tooltip-text: _("Open Working Directory");
        }

        Button btn_toggle_git {
          icon-name: "xsi-git-symbolic";
          tooltip-text: _("Switch to Git Commit History");
          sensitive: false;
        }

        Button btn_global_search {
          icon-name: "edit-find-symbolic";
          tooltip-text: _("Global Content Search (Ctrl+Shift+F)");
          sensitive: false;
        }

        Button btn_undo {
          icon-name: "edit-undo-symbolic";
          tooltip-text: _("Undo");
          sensitive: false;
        }

        Button btn_redo {
          icon-name: "edit-redo-symbolic";
          tooltip-text: _("Redo");
          sensitive: false;
        }

        title-widget: Adw.WindowTitle {
          title: _("FileCollector");
          subtitle: _("No working directory set");
        };

        [end]
        Gtk.MenuButton menu_btn {
          icon-name: "open-menu-symbolic";
          menu-model: primary_menu;
        }
      }

      content: Paned ai_paned {
       orientation: horizontal;
       margin-top: 0;
        margin-bottom: 12;
        margin-start: 18;
        margin-end: 18;
        position: 320;
       shrink-start-child: false;
       shrink-end-child: false;
       css-classes: ["paned-no-handle"];

        // AI 边栏 (最左, 可折叠) - 直接以 card Box 作为面板, 去掉冗余 Frame
        Box ai_sidebar {
           visible: false;
           hexpand: false;
           vexpand: true;
           width-request: 280;
           margin-top: 0;
            margin-bottom: 6;
            margin-start: 0;
            margin-end: 0;
            css-classes: ["ai-panel", "card"];
        }

      Paned outer_paned {
       orientation: horizontal;
       margin-top: 0;
       margin-bottom: 0;
       margin-start: 0;
       margin-end: 0;
       position: 300;
       shrink-start-child: true;
       shrink-end-child: false;
       css-classes: ["paned-no-handle"];

        // 左栏 - 目录树 / Git 历史
        Box {
           hexpand: true;
           vexpand: true;
           width-request: 200;
           margin-top: 0;
            margin-bottom: 6;
            margin-start: 0;
            margin-end: 0;
            css-classes: ["left-panel", "card"];
         Box {
           orientation: vertical;
           spacing: 0;
           hexpand: true;
           vexpand: true;

            // 标题
            Label lbl_left_title {
              label: _("Explorer");
              halign: center;
              css-classes: ["panel-title"];
              margin-top: 0;
              margin-bottom: 0;
              margin-start: 12;
              margin-end: 12;
            }

           // 内容 Stack: 文件树 / Git 历史
           Stack left_stack {
             transition-type: crossfade;
             vexpand: true;

             // 页面 1: 文件树
              Box tree_page {
                orientation: vertical;

               Gtk.SearchEntry search_entry {
                 placeholder-text: _("Search…");
                 margin-bottom: 6;
                 margin-start: 12;
                 margin-end: 12;
               }

               ScrolledWindow dir_scrolled {
                 hexpand: true;
                 vexpand: true;
                 margin-start: 12;
                 margin-end: 12;
                 margin-top: 0;
                 margin-bottom: 6;
               }
             }

             // 页面 2: Git 提交历史
              Box git_page {
                orientation: vertical;

               Gtk.SearchEntry git_search_entry {
                 placeholder-text: _("Search commit messages…");
                 margin-bottom: 6;
                 margin-start: 12;
                 margin-end: 12;
               }

               ScrolledWindow git_scrolled {
                 hexpand: true;
                 vexpand: true;
                 margin-start: 12;
                 margin-end: 12;
                 margin-top: 0;
                 margin-bottom: 6;
                 ListView git_list_view {}
               }
              }
            }
          }
        }

      Paned inner_paned {
        orientation: horizontal;
        position: 500;
        shrink-start-child: true;
        shrink-end-child: false;
        margin-start: 0;
        css-classes: ["paned-no-handle"];

        // 中栏 - 输出编排
        Box {
           hexpand: true;
           vexpand: true;
           width-request: 400;
           margin-top: 0;
            margin-bottom: 6;
            margin-start: 0;
            margin-end: 0;
            css-classes: ["middle-panel", "card"];
          Box {
              orientation: vertical;
             spacing: 0;
             hexpand: true;
             vexpand: true;

             // 标题区
             Label {
               label: _("Output Orchestration List");
               halign: center;
               css-classes: ["panel-title"];
             }

            // 队列列表区 (包一层 Overlay, 落点指示线作为独立覆盖层, 位置精确落在
            // 两行边界, 避免用行内 border/box-shadow 时 "在上方行下方" 与 "在下方行上方"
            // 两条线位置错开 2px 的问题)
            Overlay queue_overlay {
              vexpand: true;

              child: Stack queue_stack {
                vhomogeneous: true;
                hhomogeneous: true;

                StackPage {
                  name: "list";
                  // 列表页: 编排列表 (model 为空时由代码切到空状态页)
                  child: ScrolledWindow {
                    vexpand: true;
                    margin-start: 12;
                    margin-end: 12;
                    margin-top: 0;
                    margin-bottom: 6;
                    ListView queue_list {
                    }
                  };
                }
              };

              [overlay]
              Box drop_indicator {
                css-classes: ["drop-indicator"];
                height-request: 2;
                halign: fill;
                hexpand: true;
                valign: start;
                margin-start: 12;
                margin-end: 12;
                visible: true;
              }
            }

            // 操作按钮 Stack: 常规 / Git 专属
            Stack action_stack {
              transition-type: crossfade;
              margin-top: 6;
              margin-start: 12;
              margin-end: 12;

              // 页面 1: 常规编排按钮
              Box normal_actions {
                css-classes: ["normal-actions"];
                orientation: horizontal;
                halign: center;
                spacing: 6;
                Button btn_add_ext {
                  icon-name: "document-open-symbolic";
                  tooltip-text: _("Add External File");
                }
                Button btn_add_text_above {
                  sensitive: false;
                  icon-name: "go-top-symbolic";
                  tooltip-text: _("Insert Text Above");
                }
                Button btn_add_text_below {
                  sensitive: false;
                  icon-name: "go-bottom-symbolic";
                  tooltip-text: _("Insert Text Below");
                }
                Button btn_move_up {
                  sensitive: false;
                  icon-name: "go-up-symbolic";
                  tooltip-text: _("Move Up");
                }
                Button btn_move_down {
                  sensitive: false;
                  icon-name: "go-down-symbolic";
                  tooltip-text: _("Move Down");
                }
                Button btn_ai_toc {
                  sensitive: false;
                  icon-name: "view-list-ordered-symbolic";
                  tooltip-text: _("AI Reading Guide");
                }
                Button btn_delete {
                  sensitive: false;
                  css-classes: ["destructive-action"];
                  icon-name: "edit-clear-symbolic";
                  tooltip-text: _("Delete");
                }
                Button btn_clear {
                  sensitive: false;
                  css-classes: ["destructive-action"];
                  icon-name: "user-trash-symbolic";
                  tooltip-text: _("Clear");
                }
              }

              // 页面 2: Git 专属按钮
              Box git_actions {
                css-classes: ["normal-actions"];
                orientation: horizontal;
                halign: center;
                spacing: 6;

                Button btn_git_add_all_changed {
                  icon-name: "document-open-symbolic";
                  tooltip-text: _("Add All Changed Files");
                }

                Button btn_git_export_working_diff {
                  icon-name: "edit-copy-symbolic";
                  tooltip-text: _("Export Workspace Diff");
                }

                Button btn_git_export_commit_diff {
                  sensitive: false;
                  icon-name: "document-save-symbolic";
                  tooltip-text: _("Export Selected Commit Diff");
                }

                Button btn_git_delete {
                  sensitive: false;
                  css-classes: ["destructive-action"];
                  icon-name: "edit-clear-symbolic";
                  tooltip-text: _("Delete");
                }

                Button btn_git_clear {
                  sensitive: false;
                  css-classes: ["destructive-action"];
                  icon-name: "user-trash-symbolic";
                  tooltip-text: _("Clear");
                }
              }
            }

            // 选项区
            Box {
              orientation: vertical;
              spacing: 4;
              halign: center;
              margin-top: 6;
              margin-start: 12;
              margin-end: 12;

              Box {
                orientation: horizontal;
                spacing: 12;
                halign: center;

                CheckButton radio_relative_path {
                  label: _("Use Relative Paths");
                  sensitive: false;
                }

                CheckButton radio_absolute_path {
                  label: _("Use Absolute Paths");
                  group: radio_relative_path;
                  sensitive: false;
                }
              }

              CheckButton check_write_header {
                label: _("Annotate working directory info at file header");
                halign: center;
                sensitive: false;
              }
            }

            // 生成按钮
            Box {
              orientation: vertical;
              halign: center;
              spacing: 6;
              margin-top: 6;
              margin-start: 12;
              margin-end: 12;
              margin-bottom: 12;
              Box {
                orientation: horizontal;
                halign: center;
                spacing: 6;
                Button btn_generate {
                  halign: center;
                  sensitive: false;
                  css-classes: ["suggested-action"];
                  tooltip-text: _("Estimated context: 0 / 128000 Tokens");
                  Box {
                    spacing: 6;
                    halign: center;
                    Image { icon-name: "document-save-symbolic"; }
                    Label { label: _("Generate Merged Text"); }
                    DrawingArea token_ring {
                      width-request: 18;
                      height-request: 18;
                      valign: center;
                      margin-start: 4;
                    }
                  }
                }
                Gtk.MenuButton btn_more_menu {
                  valign: center;
                  icon-name: "view-more-symbolic";
                  tooltip-text: _("More Actions");
                  menu-model: generate_menu;
                }
              }
            }
           }
        }

        // 右栏 - 预览
        Box {
           hexpand: false;
           vexpand: true;
           width-request: 200;
           margin-top: 0;
            margin-bottom: 6;
            margin-start: 0;
            margin-end: 0;
            css-classes: ["right-panel", "card"];
            Box {
                orientation: vertical;
              spacing: 0;
              hexpand: true;
              vexpand: true;

              Label {
               label: _("Preview");
               halign: center;
               css-classes: ["panel-title"];
             }

             Gtk.Overlay {
               hexpand: true;
               vexpand: true;
               margin-start: 12;
               margin-end: 12;

                child: ScrolledWindow preview_scrolled {
                   hexpand: true;
                   vexpand: true;
                   Stack preview_stack {
                    transition-type: crossfade;
                    // 关键: 关闭垂直方向均一化. Gtk.Stack 默认 vhomogeneous=true,
                    // 会以"所有页面中最高的那一页"作为自身高度. 预览区切换文件时,
                    // 非可见的 preview_view 仍可能残留上一长文件内容, 导致 stack 高度
                    // 被撑高, 滚动范围不随短文件收缩, 短文件下方出现大片可滚动空白.
                    // 设为 false 后 stack 高度只取当前可见页, 滚动范围正好贴合当前文件.
                    vhomogeneous: false;
                    hhomogeneous: false;
                    hexpand: true;
                    vexpand: true;

                    GtkSource.View preview_view {
                      editable: false;
                      left-margin: 12;
                      right-margin: 12;
                      top-margin: 9;
                      bottom-margin: 12;
                    }

                    Box preview_markdown_box {
                      orientation: vertical;
                    }

                    Adw.StatusPage preview_info_box {
                      // 预览区空状态: 图标 + 标题 + 描述, 与编排列表的空状态风格统一
                      vexpand: true;
                      hexpand: true;
                    }
                  }
                };

               [overlay]
               Button btn_retry_preprocess {
                 visible: false;
                 halign: end;
                 valign: start;
                 margin-top: 6;
                 margin-end: 6;
                 icon-name: "view-refresh-symbolic";
                 tooltip-text: _("Re-run AI Conversion");
               }
             }
           }
         }
      }
    }
  };
  }
  };
}

menu primary_menu {
  section {
    item (_("Open Project..."), "app.open_project")
    item (_("Save Project"), "app.save_project")
    item (_("Save Project As..."), "app.save_as_project")
  }
  section {
    item (_("Manage Phrases..."), "app.manage_phrases")
    item (_("Manage Scene Templates..."), "app.manage_templates")
    item (_("Preferences..."), "app.preferences")
    item (_("Clear Workspace Cache"), "app.clear_cache")
  }
  section {
    item (_("Keyboard Shortcuts..."), "app.shortcuts")
    item (_("About FileCollector"), "app.about")
  }
}

menu generate_menu {
  section {
    item (_("Copy Merged Text to Clipboard"), "win.generate_to_clipboard")
    item (_("Export as ZIP"), "win.export_zip")
  }
}
